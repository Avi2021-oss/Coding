How to find vowels in a given string

Solution:
import java.util.Scanner;

public class VowelFinder {
    public static void main(String[] args) {
        // Step 1: Create a Scanner object to take user input
        Scanner scanner = new Scanner(System.in);
        
        // Step 2: Prompt the user for a string
        System.out.print("Enter a string: ");
        String input = scanner.nextLine();  // Read the entire line as input
        
        // Step 3: Close the Scanner object to prevent resource leaks
        scanner.close();
        
        // Step 4: Call the method to find and display vowels
        findVowels(input);
    }

    // Step 5: Method to find vowels in the string
    public static void findVowels(String str) {
        System.out.print("Vowels in the string: ");
        
        // Convert the string to lowercase to handle case insensitivity
        str = str.toLowerCase();
        
        // Step 6: Iterate through the string and check for vowels
        for (int i = 0; i < str.length(); i++) {
            char ch = str.charAt(i);  // Get each character
            
            // Step 7: Check if the character is a vowel
            if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') {
                System.out.print(ch + " "); // Print the vowel
            }
        }
    }
}

